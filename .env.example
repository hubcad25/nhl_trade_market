# Copy to .env (gitignored) and fill in.

# Azure OpenAI — powers the player research agent (step 5).
# The deployment `gpt-5.5` lives on the AIServices account info-4552-resource
# (resource group rg-opubliq-sondages, region eastus2).
#
# Retrieve both values with the Azure CLI:
#   az cognitiveservices account show -n info-4552-resource -g rg-opubliq-sondages \
#     --query properties.endpoint -o tsv
#   az cognitiveservices account keys list -n info-4552-resource -g rg-opubliq-sondages \
#     --query key1 -o tsv
AZURE_OPENAI_ENDPOINT=https://info-4552-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.5

# The Responses API surface is preview-only at time of writing. The hosted
# `web_search` tool is what makes the research agent work — see plan.md, step 5.
AZURE_OPENAI_API_VERSION=preview

# No search-provider key is needed. Tavily and Serper were both evaluated and
# dropped: Azure hosts the web search itself. See plan.md and the archive branch
# archive/tavily-pipeline-2026-07-28 for the abandoned Tavily pipeline.
